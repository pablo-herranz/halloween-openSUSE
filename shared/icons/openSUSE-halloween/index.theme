[Icon Theme]
Name=openSUSE Halloween
Comment=Autumn Halloween places, app, menu and launcher icons over Breeze Dark
Inherits=breeze-dark,breeze,hicolor
FollowsColorScheme=true
DesktopDefault=48
ToolbarDefault=22
PanelDefault=48
DialogDefault=32
# 16x16 comes first so its hand-simplified icons win at 16 px
Directories=16x16/places,scalable/places,scalable/apps,scalable/categories,scalable/actions

[16x16/places]
Size=16
Context=Places
Type=Fixed

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/categories]
Size=16
MinSize=16
MaxSize=512
Context=Categories
Type=Scalable

[scalable/actions]
Size=16
MinSize=16
MaxSize=512
Context=Actions
Type=Scalable
