#
# Structure from KDE Breeze's BreezeDark.colors (breeze v6.8.0).
# Palette colour names between @ signs are filled in by tools/build.py.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=@pumpkin_dark@
BackgroundNormal=@button@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@pumpkin@
ForegroundInactive=@inactive@
ForegroundLink=@apricot@
ForegroundNegative=@cranberry@
ForegroundNeutral=@candle@
ForegroundNormal=@cream@
ForegroundPositive=@olive@
ForegroundVisited=@plum@

[Colors:Complementary]
BackgroundAlternate=@pumpkin_dark@
BackgroundNormal=@complementary@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@pumpkin@
ForegroundInactive=@inactive@
ForegroundLink=@apricot@
ForegroundNegative=@cranberry@
ForegroundNeutral=@candle@
ForegroundNormal=@cream@
ForegroundPositive=@olive@
ForegroundVisited=@plum@

[Colors:Header]
BackgroundAlternate=@night@
BackgroundNormal=@header@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@pumpkin@
ForegroundInactive=@inactive@
ForegroundLink=@apricot@
ForegroundNegative=@cranberry@
ForegroundNeutral=@candle@
ForegroundNormal=@cream@
ForegroundPositive=@olive@
ForegroundVisited=@plum@

[Colors:Header][Inactive]
BackgroundAlternate=@header@
BackgroundNormal=@night@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@pumpkin@
ForegroundInactive=@inactive@
ForegroundLink=@apricot@
ForegroundNegative=@cranberry@
ForegroundNeutral=@candle@
ForegroundNormal=@cream@
ForegroundPositive=@olive@
ForegroundVisited=@plum@

[Colors:Selection]
BackgroundAlternate=@pumpkin_dark@
BackgroundNormal=@ember@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@white@
ForegroundInactive=@sel_inactive@
ForegroundLink=@sel_link@
ForegroundNegative=@sel_negative@
ForegroundNeutral=@sel_neutral@
ForegroundNormal=@white@
ForegroundPositive=@sel_positive@
ForegroundVisited=@sel_visited@

[Colors:Tooltip]
BackgroundAlternate=@night@
BackgroundNormal=@header@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@pumpkin@
ForegroundInactive=@inactive@
ForegroundLink=@apricot@
ForegroundNegative=@cranberry@
ForegroundNeutral=@candle@
ForegroundNormal=@cream@
ForegroundPositive=@olive@
ForegroundVisited=@plum@

[Colors:View]
BackgroundAlternate=@view_alt@
BackgroundNormal=@view@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@pumpkin@
ForegroundInactive=@inactive@
ForegroundLink=@apricot@
ForegroundNegative=@cranberry@
ForegroundNeutral=@candle@
ForegroundNormal=@cream@
ForegroundPositive=@olive@
ForegroundVisited=@plum@

[Colors:Window]
BackgroundAlternate=@header@
BackgroundNormal=@night@
DecorationFocus=@pumpkin@
DecorationHover=@pumpkin@
ForegroundActive=@pumpkin@
ForegroundInactive=@inactive@
ForegroundLink=@apricot@
ForegroundNegative=@cranberry@
ForegroundNeutral=@candle@
ForegroundNormal=@cream@
ForegroundPositive=@olive@
ForegroundVisited=@plum@

[General]
ColorScheme=openSUSEHalloween
Name=openSUSE Halloween
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground=@header@
activeBlend=@cream@
activeForeground=@cream@
inactiveBackground=@night@
inactiveBlend=@inactive@
inactiveForeground=@inactive@
