 * SPDX-License-Identifier: GPL-2.0-or-later
 *
 * openSUSE Halloween for GNOME Shell. The User Themes extension loads this on
 * top of the Shell's own light or dark stylesheet, so it only recolours: the
 * top bar, menus, quick settings, the calendar and on-screen displays. As in
 * Plasma: hover is a plum tint, keyboard focus a pumpkin ring, checked and
 * selected states ember behind white text, levels and sliders pumpkin.
 * St reads rgba(), st-transparentize() and st-mix(), not GTK's alpha() or
 * mix(). Palette tokens are filled in from art/palette.toml by
 * tools/targets/gnome.py.
 */

#panel {
  background-color: @night@;
}

#panel .panel-button {
  color: @cream@;
}

#panel .panel-button:hover {
  background-color: st-transparentize(@plum@, 0.75);
}

#panel .panel-button:focus {
  box-shadow: inset 0 0 0 2px @pumpkin@;
}

#panel .panel-button:active,
#panel .panel-button:checked {
  background-color: @ember@;
  color: @white@;
}

#panel .workspace-dot {
  background-color: @cream@;
}

.popup-menu-boxpointer .popup-menu-content,
.candidate-popup-boxpointer .candidate-popup-content {
  background-color: @header@;
  color: @cream@;
}

.popup-menu-item:hover {
  background-color: st-transparentize(@plum@, 0.75);
}

.popup-menu-item:focus {
  background-color: st-transparentize(@plum@, 0.75);
  box-shadow: inset 0 0 0 2px @pumpkin@;
}

.quick-settings {
  background-color: @header@;
  color: @cream@;
}

/* Off toggles, their menu arrows and the round buttons on top stand off the
   menu; on toggles are ember */
.quick-toggle,
.quick-toggle-has-menu .quick-toggle-menu-button,
.quick-settings .icon-button {
  background-color: @raised@;
  color: @cream@;
}

.quick-toggle:hover,
.quick-toggle-has-menu .quick-toggle-menu-button:hover,
.quick-settings .icon-button:hover {
  background-color: st-mix(@raised@, @plum@, 0.25);
}

.quick-toggle:focus,
.quick-toggle-has-menu .quick-toggle-menu-button:focus,
.quick-settings .icon-button:focus {
  box-shadow: inset 0 0 0 2px @pumpkin@;
}

.quick-toggle:checked,
.quick-toggle-has-menu .quick-toggle-menu-button:checked {
  background-color: @ember@;
  color: @white@;
}

.quick-toggle-has-menu:checked .quick-toggle-separator {
  background-color: st-transparentize(@white@, 0.6);
}

.quick-toggle-menu {
  background-color: @button@;
  color: @cream@;
}

.slider {
  -barlevel-active-background-color: @pumpkin@;
}

.datemenu-popover .calendar,
.message-list .message {
  background-color: @button@;
  color: @cream@;
}

.calendar .calendar-today,
.calendar .calendar-today:selected {
  background-color: @ember@;
  color: @white@;
}

.osd-window {
  background-color: @header@;
  color: @cream@;
}

.osd-window .level-bar {
  background-color: @pumpkin@;
}

.switcher-popup .switcher-list,
.workspace-switcher-container {
  background-color: @header@;
  color: @cream@;
}
