# Installed by the optional defaults (make install-defaults): the Halloween
# theme's colours, wallpaper and Shell theme as GNOME's defaults, for users who
# haven't chosen their own. Named to sort after openSUSE's 20_openSUSE-branding
# override, so it wins. It leaves the GTK and icon theme to the user (GNOME
# Tweaks): they must match gtk3-branding, or gnome-settings-daemon switches
# them back; and it doesn't touch the list of enabled Shell extensions.

[org.gnome.desktop.interface]
accent-color='orange'
color-scheme='prefer-dark'

# The login screen (GDM's greeter runs as the GNOME-Greeter desktop)
[org.gnome.desktop.interface:GNOME-Greeter]
accent-color='orange'
color-scheme='prefer-dark'

[org.gnome.desktop.background]
picture-uri='file://@LIGHT@'
picture-uri-dark='file://@DARK@'
picture-options='zoom'
primary-color='@night@'

# Used once the User Themes extension is enabled
[org.gnome.shell.extensions.user-theme]
name='openSUSE-halloween'

# IBus draws the keyboard layout (EN) in the panel itself, blue by default
[org.freedesktop.ibus.panel]
xkb-icon-rgba='@cream@'
