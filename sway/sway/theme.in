#
# openSUSE Halloween theme for sway. Include from your ~/.config/sway/config.
# See README.md for the include path.
#
# This file only defines theme colours, borders and gaps. The bar, keybindings, output
# setup, window rules and other preferences belong in your main config.

# Colours from the Halloween palette
set $night            @night@
set $view             @view@
set $view_alt         @view_alt@
set $header           @header@
set $button           @button@
set $complementary    @complementary@
set $raised           @raised@
set $border           @border@
set $pumpkin_dark     @pumpkin_dark@
set $cream            @cream@
set $inactive         @inactive@
set $white            @white@
set $pumpkin          @pumpkin@
set $ember            @ember@
set $candle           @candle@
set $apricot          @apricot@
set $plum             @plum@
set $olive            @olive@
set $cranberry        @cranberry@
set $cranberry_dark   @cranberry_dark@

# Window colours
#               border           background       text             indicator       child_border
client.focused          $pumpkin        $header          $cream           $pumpkin        $pumpkin
client.focused_inactive $border         $night           $inactive        $night          $border
client.unfocused        $border         $night           $inactive        $night          $border
client.urgent           $cranberry      $cranberry_dark  $white           $cranberry      $cranberry
client.placeholder      $complementary  $complementary   $complementary   $complementary  $complementary

# Title bar (when using titlebar decorations)
default_border pixel 2
default_floating_border pixel 2

# Gaps
gaps inner 8
gaps outer 4

# No bar here: your config's bar stays the only one (a second bar block would
# start a second Waybar). Waybar takes its colours from waybar/style.css.
